# Package versions verified working on note9pro (postmarketOS edge / Alpine edge, aarch64)
# as of 2026-09-07. setup.sh installs unpinned by default; run with PIN=1 to pin to these.
VICTORIA_METRICS_VER=1.148.2-r0
VICTORIA_METRICS_TOOLS_VER=1.148.2-r0
GRAFANA_VER=12.4.4-r1
ALERTMANAGER_VER=0.34.0-r0
NODE_EXPORTER_VER=1.12.1-r0
GO_VER=1.27.1-r0
DOTNET9_SDK_VER=9.0.120-r0

# Host settings
LAN_CIDR=192.168.1.0/24

# Optional: rootless container runtime (WITH_PODMAN=1)
PODMAN_VER=6.1.1-r1
PODMAN_COMPOSE_VER=1.6.0-r0
